{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoengineerai.local/schemas/reference_profile-v1.json",
  "title": "ReferenceProfile v1",
  "description": "Cílový profil reálného vozu (výstup ReferenceIntelligence, §3.2). Každá hodnota v specs má provenance; chybějící údaj = null + confidence 0.",
  "type": "object",
  "required": ["schema_version", "vehicle", "specs", "target_metrics"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "reference_id": { "type": "string", "pattern": "^rp_[A-Za-z0-9_]+$" },
    "vehicle": {
      "type": "object",
      "required": ["make", "model", "year"],
      "additionalProperties": true,
      "properties": {
        "make": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "year": { "type": "integer", "minimum": 1886, "maximum": 2100 }
      }
    },
    "source_vehicle_id": {
      "type": "string",
      "description": "Odkaz na bohatý DB záznam vehicle-data/references/<vehicle-id>.json (může chybět)."
    },
    "specs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/proven" }
    },
    "target_metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["metric", "target", "tolerance", "weight"],
        "additionalProperties": false,
        "properties": {
          "metric": { "type": "string", "minLength": 1 },
          "target": { "type": "number" },
          "tolerance": { "type": "number", "exclusiveMinimum": 0 },
          "weight": { "type": "number", "minimum": 0 }
        }
      }
    }
  },
  "$defs": {
    "proven": {
      "type": "object",
      "required": ["value", "source", "confidence"],
      "additionalProperties": false,
      "properties": {
        "value": { "description": "Číslo, řetězec, nebo null = chybějící údaj (pak confidence 0)." },
        "source": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "uncertainty": { "type": "string" }
      }
    }
  }
}
