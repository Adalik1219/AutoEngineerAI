{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoengineerai.local/schemas/change_plan-v1.json",
  "title": "ChangePlan v1",
  "description": "Plán změn (výstup DecisionAI, ARCHITECTURE §3.4) včetně rozhodnutí keep/adapt/replace.",
  "type": "object",
  "required": ["schema_version", "plan_id", "diagnosis_ref", "steps", "chassis_decision", "priorities", "stop_conditions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "plan_id": { "type": "string", "pattern": "^plan_[A-Za-z0-9_]+$" },
    "diagnosis_ref": { "type": "string", "pattern": "^dg_[A-Za-z0-9_]+$" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["area", "action"],
        "additionalProperties": true,
        "properties": {
          "area": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "from": { "description": "Výchozí hodnota (libovolný JSON typ)." },
          "to": { "description": "Cílová hodnota (libovolný JSON typ)." },
          "expected_effect": { "type": "string" },
          "risk": { "type": "string" }
        }
      }
    },
    "chassis_decision": { "enum": ["keep", "adapt", "replace"] },
    "priorities": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "stop_conditions": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "max_iterations": { "type": "integer", "minimum": 1 },
        "target_score": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
